{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen:icons": "node scripts/generate-icon-registry.ts",
    "predev": "npm run gen:icons",
    "dev": "vite",
    "prebuild": "npm run gen:icons",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "framer-motion": "^14.9.0",
    "gray-matter": "^4.0.3",
    "hastscript": "^9.0.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-inlinesvg": "^4.5.0",
    "react-markdown": "^10.1.0",
    "react-parallax-tilt": "^1.7.349",
    "react-router": "^8.4.0",
    "rehype-format": "^5.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
