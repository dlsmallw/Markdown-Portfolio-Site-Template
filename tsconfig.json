{
  "compilerOptions": {
    "paths": {
      "@components/*": ["./src/components/*"],
      "@components": ["./src/components"],
      "@routes/*": ["./src/routes/*"],
      "@routes": ["./src/routes"],
      "@layouts/*": ["./src/layouts/*"],
      "@layouts": ["./src/layouts"],
      "@typing/*": ["./src/typing/*"],
      "@typing": ["./src/typing"],
      "@utils/*": ["./src/utils/*"],
      "@utils": ["./src/utils"]
    },
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "plugins", "markdown"]
}
